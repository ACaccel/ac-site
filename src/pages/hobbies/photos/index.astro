---
import PageLayout from '../../../layouts/PageLayout.astro';
import AlbumGrid from '../../../components/AlbumGrid';
import PageHeader from '../../../components/PageHeader';
import RelatedPosts from '../../../components/RelatedPosts';
import ThemeRoot from '../../../theme/ThemeRoot';
import { pageTitle } from '../../../data/site';
import { formatDate, isoDate } from '../../../data/dates';
import { getAlbums, hobbyCategory } from '../../../data/hobbies';
import { responsiveImage } from '../../../data/images';
import { getPosts, postsWithTag, toPostSummary } from '../../../data/posts';

const category = hobbyCategory('photos');
const albums = await Promise.all(
  (await getAlbums()).map(async (album) => ({
    href: `/hobbies/photos/${album.id}/`,
    title: album.data.title,
    date: formatDate(album.data.date),
    dateISO: isoDate(album.data.date),
    location: album.data.location,
    cover: await responsiveImage(album.data.cover, [400, 800]),
    coverAlt: album.data.title,
  })),
);
const relatedPosts = postsWithTag(await getPosts(), category.tag).map(toPostSummary);
---

<PageLayout title={pageTitle(category.title)} description={category.description}>
  <PageHeader title={category.title} description={category.description} />
  <AlbumGrid albums={albums} />
  <ThemeRoot>
    <RelatedPosts posts={relatedPosts} tag={category.tag} />
  </ThemeRoot>
</PageLayout>
