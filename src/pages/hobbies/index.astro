---
import PageLayout from '../../layouts/PageLayout.astro';
import HobbyHub from '../../components/HobbyHub';
import { pageTitle } from '../../data/site';
import { text } from '../../data/text';
import { getHobbyCounts, hobbyCategories } from '../../data/hobbies';
import { getPosts, toPostSummary } from '../../data/posts';

const relatedPostCount = 6;
const tags = new Set(hobbyCategories.map((category) => category.tag));
const posts = (await getPosts())
  .filter((post) => post.data.tags.some((tag) => tags.has(tag)))
  .slice(0, relatedPostCount)
  .map(toPostSummary);
const counts = await getHobbyCounts();
---

<PageLayout title={pageTitle(text.hobbies.title)} description={text.hobbies.description}>
  <HobbyHub categories={hobbyCategories} counts={counts} posts={posts} />
</PageLayout>
