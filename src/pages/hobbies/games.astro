---
import PageLayout from '../../layouts/PageLayout.astro';
import LogPage from '../../components/LogPage';
import { pageTitle } from '../../data/site';
import { getGameGroups, hobbyCategory } from '../../data/hobbies';
import { getPosts, postsWithTag, toPostSummary } from '../../data/posts';

const category = hobbyCategory('games');
const groups = await getGameGroups();
const relatedPosts = postsWithTag(await getPosts(), category.tag).map(toPostSummary);
---

<PageLayout title={pageTitle(category.title)} description={category.description}>
  <LogPage
    title={category.title}
    description={category.description}
    groups={groups}
    relatedPosts={relatedPosts}
    relatedTag={category.tag}
  />
</PageLayout>
