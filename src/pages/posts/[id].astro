---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import PageHeader from '../../components/PageHeader';
import Prose from '../../components/Prose';
import { profile } from '../../data/profile';
import { formatDate, isoDate } from '../../data/dates';
import { getPosts, type Post } from '../../data/posts';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, description, date, updated } = post.data;
const { Content } = await render(post);
---

<PageLayout
  title={`${title} | ${profile.name}`}
  description={description}
  width="narrow"
  ogType="article"
>
  <article>
    <PageHeader title={title}>
      <time datetime={isoDate(date)}>{formatDate(date)}</time>
      {updated && (
        <>
          {' · 更新於 '}
          <time datetime={isoDate(updated)}>{formatDate(updated)}</time>
        </>
      )}
    </PageHeader>
    <Prose>
      <Content />
    </Prose>
  </article>
</PageLayout>
