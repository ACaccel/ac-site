---
import PageLayout from '../layouts/PageLayout.astro';
import HomePage from '../components/HomePage';
import { profile } from '../data/profile';
import { site } from '../data/site';
import { getPosts, toPostSummary } from '../data/posts';
import { getServices } from '../data/services';
import { getProjects, toProjectSummary } from '../data/projects';
import { getNow } from '../data/now';
import { formatDate, isoDate } from '../data/dates';

const recentPostCount = 3;
const posts = (await getPosts()).slice(0, recentPostCount).map(toPostSummary);
const services = (await getServices()).filter((service) => service.status !== 'archived');
const projects = (await getProjects())
  .filter((project) => project.data.featured)
  .map(toProjectSummary);
const nowEntry = await getNow();
const now = nowEntry && {
  summary: nowEntry.data.summary,
  updated: formatDate(nowEntry.data.updated),
  updatedISO: isoDate(nowEntry.data.updated),
};
---

<PageLayout title={profile.name} description={site.description}>
  <HomePage now={now} posts={posts} projects={projects} services={services} />
</PageLayout>
