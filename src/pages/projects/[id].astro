---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import ProjectDetail from '../../components/ProjectDetail';
import { pageTitle } from '../../data/site';
import {
  getProjects,
  getProjectService,
  toProjectSummary,
  type Project,
} from '../../data/projects';

export const getStaticPaths = (async () => {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}) satisfies GetStaticPaths;

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { Content } = await render(project);
const service = await getProjectService(project);
---

<PageLayout
  title={pageTitle(project.data.title)}
  description={project.data.summary}
  width="narrow"
  ogType="article"
>
  <ProjectDetail project={toProjectSummary(project)} links={project.data.links} service={service}>
    <Content />
  </ProjectDetail>
</PageLayout>
