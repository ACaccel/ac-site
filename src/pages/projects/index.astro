---
import PageLayout from '../../layouts/PageLayout.astro';
import PageHeader from '../../components/PageHeader';
import ProjectList from '../../components/ProjectList';
import { pageTitle } from '../../data/site';
import { text } from '../../data/text';
import { getProjects, toProjectSummary } from '../../data/projects';

const projects = (await getProjects()).map(toProjectSummary);
---

<PageLayout title={pageTitle(text.projects.title)} description={text.projects.description}>
  <PageHeader title={text.projects.title} description={text.projects.description} />
  <ProjectList projects={projects} />
</PageLayout>
