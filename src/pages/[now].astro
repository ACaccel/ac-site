---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import PageHeader from '../components/PageHeader';
import Prose from '../components/Prose';
import { pageTitle } from '../data/site';
import { around, text } from '../data/text';
import { formatDate, isoDate } from '../data/dates';
import { getNow, type Now } from '../data/now';

// A dynamic route only so the page can be skipped while now.md is a draft.
export const getStaticPaths = (async () => {
  const now = await getNow();
  return now ? [{ params: { now: 'now' }, props: { now } }] : [];
}) satisfies GetStaticPaths;

interface Props {
  now: Now;
}

const { now } = Astro.props;
const { Content } = await render(now);
const updatedText = around(text.now.updated, 'date');
---

<PageLayout title={pageTitle(text.now.title)} description={now.data.summary} width="narrow">
  <PageHeader title={text.now.title} description={now.data.summary}>
    {updatedText[0]}
    <time datetime={isoDate(now.data.updated)}>{formatDate(now.data.updated)}</time>
    {updatedText[1]}
  </PageHeader>
  <Prose>
    <Content />
  </Prose>
</PageLayout>
