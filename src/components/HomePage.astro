---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from './PostList.astro';
import ServiceList from './ServiceList.astro';
import SiteHeader from './SiteHeader.astro';
import { Content as About } from '../content/about.md';
import { profile } from '../data/profile';
import { getPosts } from '../data/posts';

const recentPostCount = 5;
const posts = await getPosts();
const recentPosts = posts.slice(0, recentPostCount);
---

<BaseLayout
  title={profile.name}
  description="ACaccel 的個人網站，以及部署在 acserver.csie.org 上的服務。"
>
  <SiteHeader />
  <main>
    <section class="intro">
      <h1>{profile.name}</h1>
      <div class="prose">
        <About />
      </div>
    </section>
    {recentPosts.length > 0 && (
      <section aria-labelledby="posts-heading">
        <h2 id="posts-heading">文章</h2>
        <PostList posts={recentPosts} />
        {posts.length > recentPostCount && (
          <p>
            <a href="/posts/">所有文章</a>
          </p>
        )}
      </section>
    )}
    <section aria-labelledby="services-heading">
      <h2 id="services-heading">服務</h2>
      <ServiceList />
    </section>
    <section aria-labelledby="links-heading">
      <h2 id="links-heading">連結</h2>
      <ul class="links">
        {profile.links.map((link) => (
          <li>
            <a href={link.href} rel="me noopener">
              {link.label}
            </a>
          </li>
        ))}
        {profile.email && (
          <li>
            <a href={`mailto:${profile.email}`}>{profile.email}</a>
          </li>
        )}
      </ul>
    </section>
  </main>
</BaseLayout>
