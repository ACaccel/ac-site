---
import { getRelativeLocaleUrl } from 'astro:i18n';
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/profile';
import { defaultLocale, isLocale, useTranslations } from '../i18n/ui';

const locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : defaultLocale;
const otherLocale = locale === 'en' ? 'zh-TW' : 'en';
const t = useTranslations(locale);
---

<BaseLayout title={profile.name} description={t('site.description')}>
  <header class="site-header">
    <span class="site-name">{profile.name}</span>
    <a
      class="lang-switch"
      href={getRelativeLocaleUrl(otherLocale)}
      hreflang={otherLocale}
      lang={otherLocale}
    >
      {t('lang.switch')}
    </a>
  </header>
  <main>
    <section class="intro">
      <h1>{t('intro.greeting')}</h1>
      <p>{t('intro.body')}</p>
    </section>
    <section aria-labelledby="links-heading">
      <h2 id="links-heading">{t('links.heading')}</h2>
      <ul class="links">
        {profile.links.map((link) => (
          <li>
            <a href={link.href} rel="me noopener">
              {link.label}
            </a>
          </li>
        ))}
        {profile.email && (
          <li>
            <a href={`mailto:${profile.email}`}>Email</a>
          </li>
        )}
      </ul>
    </section>
  </main>
</BaseLayout>
