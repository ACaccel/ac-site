---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceList from './ServiceList.astro';
import { profile } from '../data/profile';
---

<BaseLayout
  title={profile.name}
  description="ACaccel's personal website and the services hosted on acserver.csie.org."
>
  <header class="site-header">
    <span class="site-name">{profile.name}</span>
  </header>
  <main>
    <section class="intro">
      <h1>{profile.name}</h1>
      <p>
        Based at the Department of Electrical Engineering, National Taiwan University, working on
        software development and server operations. This site lists the public services hosted on
        this server.
      </p>
    </section>
    <section aria-labelledby="services-heading">
      <h2 id="services-heading">Services</h2>
      <ServiceList />
    </section>
    <section aria-labelledby="links-heading">
      <h2 id="links-heading">Links</h2>
      <ul class="links">
        {profile.links.map((link) => (
          <li>
            <a href={link.href} rel="me noopener">
              {link.label}
            </a>
          </li>
        ))}
        {profile.email && (
          <li>
            <a href={`mailto:${profile.email}`}>{profile.email}</a>
          </li>
        )}
      </ul>
    </section>
  </main>
</BaseLayout>
